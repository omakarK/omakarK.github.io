{
  "name": "oak-and-whimsy-shop",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "dev": "vite --host 127.0.0.1",
    "db:setup": "node --env-file-if-exists=.env dist/server/migrate.js",
    "admin": "node --env-file-if-exists=.env dist/server/create-admin.js"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.5.0",
    "express": "^5.1.0",
    "mysql2": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
